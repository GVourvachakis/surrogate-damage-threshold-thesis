\newcommand{\GVBackupButton}[2]{%
  \hyperlink{#1}{%
    \tikz[baseline=-0.55ex]\node[
      draw=GVTeal,
      fill=GVTealTint,
      rounded corners=2pt,
      inner xsep=5pt,
      inner ysep=2pt,
      font=\scriptsize,
      text=GVTeal
    ] {#2};%
  }%
}
\newcommand{\GVBackupIndexButton}{\GVBackupButton{supp:index}{Index}}
\newcommand{\GVBackupSectionButton}[2]{\GVBackupButton{#1}{#2}}
\newcommand{\GVBackupCard}[3]{%
  \begin{tikzpicture}[baseline=-0.55ex]
    \node[
      draw=GVTeal,
      fill=GVTealTint,
      rounded corners=2pt,
      line width=0.55pt,
      inner xsep=5pt,
      inner ysep=4pt,
      align=left
    ] {\begin{minipage}{0.90\textwidth}\raggedright%
      \hyperlink{#1}{\small\textbf{\color{GVTitleRed}#2}}\par
      \vspace{0.08cm}\scriptsize\color{GVSlate}#3\par
      \vspace{0.10cm}\hyperlink{#1}{\scriptsize\color{GVTeal}\textbf{Open section}}%
    \end{minipage}};
  \end{tikzpicture}%
}

