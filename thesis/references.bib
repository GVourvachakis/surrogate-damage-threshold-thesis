@article{Qiu_1993,
  author   = {Qiu, T. Q. and Tien, C. L.},
  title    = {Heat Transfer Mechanisms During Short-Pulse Laser Heating of Metals},
  journal  = {Journal of Heat Transfer},
  volume   = {115},
  number   = {4},
  pages    = {835-841},
  year     = {1993},
  month    = {11},
  abstract = {This work studies heat transfer mechanisms during ultrafast laser heating of metals from a microscopic point of view. The heating process is composed of three processes: the deposition of radiation energy on electrons, the transport of energy by electrons, and the heating of the material lattice through electron-lattice interactions. The Boltzmann transport equation is used to model the transport of electrons and electron-lattice interactions. The scattering term of the Boltzmann equation is evaluated from quantum mechanical considerations, which shows the different contributions of the elastic and inelastic electron-lattice scattering processes on energy transport. By solving the Boltzmann equation, a hyperbolic two-step radiation heating model is rigorously established. It reveals the hyperbolic nature of energy flux carried by electrons and the nonequilibrium between electrons and the lattice during fast heating processes. Predictions from the current model agree with available experimental data during subpicosecond laser heating.},
  issn     = {0022-1481},
  doi      = {10.1115/1.2911377},
  url      = {https://doi.org/10.1115/1.2911377},
  eprint   = {https://asmedigitalcollection.asme.org/heattransfer/article-pdf/115/4/835/5698866/835_1.pdf}
}

@inbook{Tzou_2014ch1,
  publisher = {John Wiley \& Sons, Ltd},
  isbn      = {9781118818275},
  title     = {Heat Transport by Phonons and Electrons},
  booktitle = {Macro- to Microscale Heat Transfer},
  chapter   = {1},
  pages     = {1-59},
  doi       = {https://doi.org/10.1002/9781118818275.ch1},
  url       = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781118818275.ch1},
  eprint    = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781118818275.ch1},
  year      = {2014},
  keywords  = {microscale heat transfer, phase lags, phonon radiative transfer model, phonon-electron interaction model, phonon-scattering model, thermal wave model},
  abstract  = {Summary This chapter provides a brief summary of existing microscale heat-transfer models, including the microscopic two-step model (phonon-electron interaction (for metals) model), phonon-scattering (for semiconductors, dielectric crystals, and insulators) model, phonon radiative transfer model, and the thermal wave model. The first three models emphasize microscale effects in space, while the fourth, the thermal wave model, describes microscale effects in time. Phase lags are time constants characterizing the ultrafast transient process of heat transport in small scales. They are the pillars in support of thermal lagging, and are new thermophysical properties in micro/nanoscale heat transfer. The chapter describes the temperature dependence of the two phase lags, namely phase lag of the temperature gradient and phase lag of the heat flux vector in the dual-phase-lag model.}
}

@inbook{Tzou_2014ch2,
  publisher = {John Wiley \& Sons, Ltd},
  isbn      = {9781118818275},
  title     = {Lagging Behavior},
  booktitle = {Macro- to Microscale Heat Transfer},
  chapter   = {2},
  pages     = {61-124},
  doi       = {https://doi.org/10.1002/9781118818275.ch2},
  url       = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781118818275.ch2},
  eprint    = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781118818275.ch2},
  year      = {2014},
  keywords  = {depth of thermal penetration, fast-transient process, heat flux formulation, microscale heat transfer, microstructural interactions, nanoscale heat transfer, phase-lag concept, temperature formulation},
  abstract  = {Summary This chapter explains the physical foundation and mathematical methods describing the lagging response in times comparable to the phase lags characterizing the microstructural interactions. The chapter establishes the theoretical foundation for the lagging response in times comparable to the characteristic times in micro/nanoscale heat transfer. It results in a new type of energy equation in heat transport, capturing the classical theories of diffusion, thermal waves, phonon scattering, and phonon-electron interaction in the same framework of thermal lagging. The resulting model employing the two phase lags in describing the transient process is called the dual-phase-lag model. Universality of the dual-phase-lag model facilitates a consistent approach describing the intrinsic transition from one type of behavior (diffusion, for example) to another (phonon-electron interaction or phonon scattering) associated with shortening of the response time.}
}

